{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["packages/configs/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        "index.html",
        "package.json",
        "tsconfig*.json",
        "postcss.config.*",
        "vite.config.*",
        "capacitor.config.*",
        "scripts/**",
        ".env",
        ".env.*",
        "$ANALYZE",
        "eslint.config.*",
        ".browserslistrc",
        "browserslist"
      ],
      "env": ["VITE_*", "ECHOTALK_BUILD_*"],
      "outputs": ["dist/**", "stats.html"]
    },
    "build:web": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        "index.html",
        "package.json",
        "tsconfig*.json",
        "postcss.config.*",
        "vite.config.*",
        "scripts/**",
        ".env",
        ".env.*",
        ".browserslistrc",
        "browserslist"
      ],
      "env": ["VITE_*", "ECHOTALK_BUILD_*"],
      "outputs": ["dist/web/**"]
    },
    "build:ios": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        "index.html",
        "package.json",
        "tsconfig*.json",
        "postcss.config.*",
        "vite.config.*",
        "capacitor.config.*",
        "scripts/**",
        ".env",
        ".env.*",
        ".browserslistrc",
        "browserslist"
      ],
      "env": ["VITE_*", "ECHOTALK_BUILD_*"],
      "outputs": ["dist/ios/**"]
    },
    "build:macos": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        "index.html",
        "package.json",
        "tsconfig*.json",
        "postcss.config.*",
        "vite.config.*",
        "scripts/**",
        ".env",
        ".env.*",
        "eslint.config.*",
        ".browserslistrc",
        "browserslist",
        "src-tauri/tauri.conf.json"
      ],
      "env": ["VITE_*", "ECHOTALK_BUILD_*", "ANALYZE"],
      "outputs": ["dist/macos/**", "stats.html"]
    },
    "test:build": {
      "inputs": ["scripts/**", "package.json", "turbo.json"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**", "package.json", "eslint.config.*", ".eslintignore", "tsconfig*.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "package.json", "tsconfig*.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["src/**", "package.json"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
