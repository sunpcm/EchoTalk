# Local development only. Production must use AUTH_MODE=oidc.
AUTH_MODE=dev
DEV_AUTH_TOKEN=replace-with-a-local-random-token
VITE_AUTH_MODE=dev
VITE_DEV_AUTH_TOKEN=replace-with-the-same-local-random-token

# OIDC production mode (issuer must match the token iss claim exactly).
# AUTH_MODE=oidc
# OIDC_ISSUER=https://identity.example.com
# OIDC_AUDIENCE=echotalk-api
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# VITE_AUTH_MODE=oidc
# VITE_OIDC_AUTHORITY=https://identity.example.com
# VITE_OIDC_CLIENT_ID=echotalk-web
# VITE_OIDC_REDIRECT_URI=https://app.example.com/auth/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://app.example.com/
# VITE_OIDC_SCOPE=openid profile email

# Generate each Fernet key with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEYS={"local-v1":"h42Fc91-ukjBVhrQWp6JsewfYSR41rKjGto4UscO4kc="}
ACTIVE_CREDENTIAL_KEY_VERSION=local-v1

# Only during migration from the historical JWT-derived ciphertext format.
# Remove after all rows have been lazily re-encrypted with the active key.
# LEGACY_CREDENTIAL_DECRYPTION_SECRET=the-previous-jwt-secret
