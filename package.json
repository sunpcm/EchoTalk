{
  "name": "echotalk",
  "version": "1.0.0",
  "description": "EchoTalk - AI-powered real-time English learning and speaking practice platform",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:vite": "turbo dev --filter=vite-app",
    "build": "turbo build",
    "build:web": "turbo build:web",
    "build:ios": "turbo build:ios",
    "sync:ios": "pnpm --filter vite-app sync:ios",
    "test:build": "pnpm --filter vite-app test:build",
    "build:analyze:vite": "cross-env ANALYZE=true turbo build --filter=vite-app",
    "prepare": "husky",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "rimraf **/node_modules",
    "clean:cache": "rimraf .turbo **/dist **/.vite **/.webpack_cache **/node_modules.vite",
    "clean:all": "pnpm run clean:cache && pnpm run clean"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.0",
  "devDependencies": {
    "@biu/eslint-config": "workspace:*",
    "@biu/prettier-config": "workspace:*",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "catalog:",
    "rimraf": "^6.1.2",
    "turbo": "^2.7.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,md,json,yaml,yml}": [
      "prettier --write"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "prettier": "@biu/prettier-config"
}
